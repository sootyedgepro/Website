# SootyEdge environment variables. Copy to .env.local (Vercel dev) or set in
# the Vercel project dashboard for production.

# ── Anthropic (shared by /api/chat and /api/analyze) ───────────────────
ANTHROPIC_API_KEY=

# ── Dex OAuth (local dev only — DO NOT set in production) ──────────────
# When set, /api/dex/chat authenticates with your Claude Max/Pro
# subscription via the Claude Code OAuth flow instead of burning API
# credits. Token format: sk-ant-oat01-...
# Get it from your local Claude Code credentials:
#   Windows: %USERPROFILE%\.claude\.credentials.json  → access_token field
#   macOS:   Keychain entry "Claude Code" (login keychain)
#   Linux:   ~/.claude/.credentials.json              → access_token field
# Tokens expire (~1h); refresh by running `claude` once or copying again.
# Leave blank in Vercel production env — use ANTHROPIC_API_KEY there.
ANTHROPIC_OAUTH_TOKEN=

# ── Airtable (shared) ──────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Lead-qual chat copy (used by /api/chat) ────────────────────────────
BRAND_NAME=SootyEdge
CAL_BOOKING_LINK=
DISCORD_LINK=
FREE_RESOURCE_LINK=

# ── Dex / TradeGrader (used by /api/analyze) ───────────────────────────
# Polygon.io — Options Starter + Reference tier is enough for v1
# (atm IV at nearest expiry + earnings calendar). Optional: if unset,
# Dex skips IV/earnings enrichment and grades on Yahoo data only.
POLYGON_API_KEY=

# Per-email rate limits. Defaults are 3/min and 50/day.
DEX_RATE_LIMIT_PER_MIN=3
DEX_RATE_LIMIT_PER_DAY=50
